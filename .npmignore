# Compiled binaries + release artifacts — too large for npm (users run via bun
# directly). Only dist/web/ (the prebuilt frontend) ships. Leftovers from a prior
# `scripts/release.sh` run must never leak into the tarball (ERR_STRING_TOO_LONG).
dist/ppm
dist/ppm-*
dist/ppm.exe
dist/.cli-cache/
dist/*.tar.gz
dist/*.zip
dist/SHA256SUMS

# Build tools may leak absolute host paths into the repo as literal dirs
# (e.g. `C:/Users/.../AppData/Local/Temp/ppmbuild/`). A drive-letter colon is an
# illegal Windows filename, so such an entry aborts tarball extraction on Windows
# ("ENOENT extracting tarball"). Match the path segments — the drive-letter dir
# name may carry a lookalike-colon char that a literal `C:` pattern won't catch.
Users/
AppData/
ppmbuild/

# Keep dist/web/ for pre-built frontend

